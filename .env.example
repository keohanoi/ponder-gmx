# RPC URL for Mantle Sepolia network
PONDER_RPC_URL_5003=https://rpc.sepolia.mantle.xyz

# Alternative RPC providers (uncomment to use)
# Alchemy (if available)
# PONDER_RPC_URL_5003=https://mantle-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Other Mantle Sepolia RPC endpoints
# PONDER_RPC_URL_5003=https://rpc.sepolia.mantle.xyz

# Database Configuration
# For local development (uses PGlite by default)
# DATABASE_URL=

# For production (PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost:5432/gmx_indexer

# Optional: Set custom start block for Mantle Sepolia
# MANTLE_SEPOLIA_START_BLOCK=1000000

# Optional: Rate limiting
# MAX_RPC_REQUESTS_PER_SECOND=50

# Optional: Development settings
# PONDER_LOG_LEVEL=info
# PONDER_PORT=42069