{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "ponder:registry": ["./node_modules/ponder/dist/types/generated.d.ts"],
      "ponder:schema": ["./node_modules/ponder/dist/types/generated.d.ts"]
    }
  },
  "include": [
    "src/**/*",
    "ponder.config.ts",
    "ponder.schema.ts"
  ],
  "exclude": ["node_modules"]
}